{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Policy tags on sensitive columns, their masking rules and readers",
  "type": "object",
  "additionalProperties": false,
  "required": ["tags", "products"],
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"},
    "tagged_columns": {
      "description": "The tag on each personal column of the product's contract, keyed <table>.<column>.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/slug"}
    },
    "awaited_tags": {
      "description": "The tags a product with no contract yet will carry.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/slug"}
    },
    "personas": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/slug"}
    }
  },
  "properties": {
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "marks", "masking", "clear", "masked"],
        "properties": {
          "id": {
            "description": "The policy tag's name, and with hyphens as underscores its masking rule's id.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$"
          },
          "marks": {"type": "string", "minLength": 1},
          "masking": {"enum": ["nullify", "hash", "last-four"]},
          "clear": {"$ref": "#/$defs/personas"},
          "masked": {"$ref": "#/$defs/personas"}
        }
      }
    },
    "products": {
      "description": "Per data product, its tagged columns, or the tags it awaits while it has no contract.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/slug"},
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["columns"],
            "properties": {"columns": {"$ref": "#/$defs/tagged_columns"}}
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["awaiting"],
            "properties": {"awaiting": {"$ref": "#/$defs/awaited_tags"}}
          }
        ]
      }
    }
  }
}
