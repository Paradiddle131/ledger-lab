{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personas and their grants",
  "type": "object",
  "additionalProperties": false,
  "required": ["entities", "data_products", "personas", "grants"],
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"},
    "text": {"type": "string", "minLength": 1}
  },
  "properties": {
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "currency", "brings"],
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "name": {"$ref": "#/$defs/text"},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "brings": {"$ref": "#/$defs/text"}
        }
      }
    },
    "data_products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "holds"],
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "scope": {"enum": ["entity", "group"]},
          "holds": {"$ref": "#/$defs/text"},
          "tables": {
            "description": "The warehouse tables the models build for the product; absent while they build none.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
          }
        }
      }
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "duties"],
        "properties": {
          "id": {
            "description": "A valid service account id: 6 to 30 characters, lowercase letters, digits and hyphens.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
          },
          "name": {"$ref": "#/$defs/text"},
          "kind": {"enum": ["human", "agent"]},
          "duties": {"$ref": "#/$defs/text"}
        }
      }
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["persona", "product", "access"],
        "properties": {
          "persona": {"$ref": "#/$defs/slug"},
          "entity": {"$ref": "#/$defs/slug"},
          "product": {"$ref": "#/$defs/slug"},
          "access": {"enum": ["read", "aggregate", "edit", "draft", "post"]}
        }
      }
    }
  }
}
