{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Purposes: the columns each kind of work reads and the personas that do it",
  "type": "object",
  "additionalProperties": false,
  "required": ["purposes"],
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
  },
  "properties": {
    "purposes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "for", "personas", "tables"],
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "for": {"type": "string", "minLength": 1},
          "personas": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/slug"}
          },
          "tables": {
            "description": "Each product table the purpose reads, with the columns it needs.",
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"$ref": "#/$defs/name"},
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/name"}
            }
          }
        }
      }
    }
  }
}
