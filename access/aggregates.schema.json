{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aggregate tables and the minimum group",
  "type": "object",
  "additionalProperties": false,
  "required": ["minimum_group", "products"],
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "names": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/name"}}
  },
  "properties": {
    "minimum_group": {
      "description": "The fewest units a group may hold to be shown.",
      "type": "integer",
      "minimum": 2
    },
    "products": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/slug"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "from", "group_by", "sum", "units"],
          "properties": {
            "name": {"$ref": "#/$defs/name"},
            "from": {"$ref": "#/$defs/name"},
            "group_by": {"$ref": "#/$defs/names"},
            "sum": {"$ref": "#/$defs/names"},
            "units": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "minProperties": 2,
              "maxProperties": 2,
              "properties": {
                "name": {"$ref": "#/$defs/name"},
                "count_distinct": {"$ref": "#/$defs/name"},
                "sum": {"$ref": "#/$defs/name"}
              }
            }
          }
        }
      }
    }
  }
}
