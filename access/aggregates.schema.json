{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aggregate tables and the minimum group",
  "type": "object",
  "additionalProperties": false,
  "required": ["minimum_group", "minimum_entities", "products"],
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "names": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/name"}}
  },
  "properties": {
    "minimum_group": {
      "description": "The fewest payees a group may hold to be shown.",
      "type": "integer",
      "minimum": 2
    },
    "minimum_entities": {
      "description": "The fewest entities whose rows the persona reads nowhere that a group across all entities must hold, their rows alone holding the minimum group.",
      "type": "integer",
      "minimum": 1
    },
    "products": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/slug"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_rows", "tables"],
        "properties": {
          "entity_rows": {
            "description": "Whether the grain keeps each entity apart (adding entity_group_by and entity_sum).",
            "type": "boolean"
          },
          "tables": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "from", "group_by", "sum", "entity_group_by", "units"],
              "properties": {
                "name": {"$ref": "#/$defs/name"},
                "from": {"$ref": "#/$defs/name"},
                "group_by": {"$ref": "#/$defs/names"},
                "sum": {"$ref": "#/$defs/names"},
                "entity_group_by": {"$ref": "#/$defs/names"},
                "entity_sum": {"$ref": "#/$defs/names"},
                "units": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "minProperties": 2,
                  "maxProperties": 2,
                  "properties": {
                    "name": {"$ref": "#/$defs/name"},
                    "count_distinct": {"$ref": "#/$defs/name"},
                    "max": {"$ref": "#/$defs/name"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
