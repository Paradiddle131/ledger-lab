{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sources the fetch kit downloads and verifies",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "$defs": {
    "link": {"type": "string", "pattern": "^https?://[^\\s]+$"},
    "text": {"type": "string", "minLength": 1},
    "one_parameter": {
      "description": "One query parameter, named as the portal names it, and its value.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/text"}
    }
  },
  "properties": {
    "sources": {
      "description": "Each source by name; the name is also the landed file's name.",
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._-]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "licence", "publisher"],
        "oneOf": [{"required": ["url"]}, {"required": ["query"]}],
        "properties": {
          "url": {"$ref": "#/$defs/link", "description": "A fixed file, fetched as published."},
          "query": {
            "description": "A live table, pinned to an ordered query with a cut-off so a re-fetch returns the same bytes.",
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "order", "cut_off"],
            "properties": {
              "url": {"$ref": "#/$defs/link"},
              "order": {"$ref": "#/$defs/one_parameter"},
              "cut_off": {"$ref": "#/$defs/one_parameter"}
            }
          },
          "sha256": {
            "description": "SHA-256 of the publisher's raw response, before any step of the source runs.",
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "licence": {"$ref": "#/$defs/link", "description": "Link to the publisher's licence."},
          "publisher": {"$ref": "#/$defs/text"}
        }
      }
    }
  }
}
