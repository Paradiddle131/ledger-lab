# Data never enters the tree: download scripts and checksums do. A sample whose licence is
# confirmed is added with `git add -f`.
data/
downloads/
landing/
*.csv
# The one exception: the dbt seeds, reference tables authored in the tree, each named exactly here
# and in platform/fresh_clone.py, which refuses any other data file or `!` line.
!/models/seeds/calendars/fiscal_year_starts.csv
!/models/seeds/calendars/period_status.csv
# Real ECB rates, a licence-allowed sample (free use with the source cited) the translation tests need.
!/models/seeds/reference/fx/ecb_rates_sample.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.zip
*.gz
*.json.gz
*.db
*.sqlite
*.duckdb

