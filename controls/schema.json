{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controls catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["layers", "controls"],
  "properties": {
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layer", "owner", "asserts", "proven_by", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"},
          "layer": {"type": "string"},
          "owner": {"description": "The id of the persona accountable for the control.", "type": "string"},
          "asserts": {"type": "string", "minLength": 1},
          "proven_by": {
            "description": "The tests that prove it, each as tests/<path>.py::<test name>.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^tests/[a-z0-9_/]+\\.py::test_[a-z0-9_]+$"}
          },
          "status": {"enum": ["not-implemented", "implemented"]},
          "awaits": {
            "description": "For a not-implemented control whose proving tests exist: the parameter of each of them that still skips, and what they prove without it.",
            "type": "object",
            "additionalProperties": false,
            "required": ["parameter", "until_then"],
            "properties": {
              "parameter": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "until_then": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
